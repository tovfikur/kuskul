APP_NAME="KusKul SMS API"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./dev.db"

JWT_ISSUER="kuskul"
JWT_AUDIENCE="kuskul-web"
JWT_SECRET_KEY="change-me-please-32-bytes"
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_COOKIE_NAME="refresh_token"
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE="lax"

CORS_ORIGINS="http://localhost:5173"

REDIS_URL="redis://redis:6379/0"
AI_MODEL_PATH="/app/models/phi-3-mini-4k-instruct-q4_k_m.gguf"
AI_MODEL_PATH_CONTENT="/app/models/phi-3-mini-4k-instruct-q4_k_m.gguf"
AI_MODEL_PATH_REPAIR="/app/models/starcoder-lite.gguf"
AI_BUILDER_ROLE="repair"
AI_BUILDER_TEMPERATURE="0.0"
AI_JSON_GRAMMAR="true"
AI_REPAIR_ENABLED="true"
AI_PROGRESS_LOGS="true"
AI_STREAM_PROGRESS="true"
